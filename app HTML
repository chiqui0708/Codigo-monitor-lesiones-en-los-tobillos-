<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monitor de Temperatura Corporal</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');
  :root {
    --blue-900:#0D2E6E; --blue-800:#1565C0; --blue-600:#1976D2;
    --blue-400:#42A5F5; --blue-100:#BBDEFB; --blue-50:#E3F2FD;
    --white:#FFFFFF; --gray-50:#F8FAFC; --gray-100:#F1F5F9;
    --gray-200:#E2E8F0; --gray-400:#94A3B8; --gray-600:#475569;
    --gray-800:#1E293B; --green:#2E7D32; --green-bg:#E8F5E9;
    --red:#C62828; --red-bg:#FFEBEE; --amber:#E65100; --amber-bg:#FFF3E0;
    --radius-sm:6px; --radius:10px; --radius-lg:14px;
    --shadow-sm:0 1px 3px rgba(13,46,110,0.08);
    --shadow:0 2px 8px rgba(13,46,110,0.10);
    --shadow-lg:0 8px 24px rgba(13,46,110,0.14);
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'Inter',sans-serif;background:var(--gray-50);color:var(--gray-800);min-height:100vh;font-size:14px;}
  .topbar{background:var(--blue-900);color:var(--white);padding:0 28px;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:var(--shadow-lg);}
  .topbar-left{display:flex;align-items:center;gap:12px;}
  .topbar-logo{width:36px;height:36px;background:var(--blue-800);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:18px;}
  .topbar-title{font-size:15px;font-weight:600;}
  .topbar-sub{font-size:11px;color:var(--blue-100);margin-top:1px;}
  .topbar-right{display:flex;align-items:center;gap:10px;}
  .status-dot{width:8px;height:8px;border-radius:50%;background:var(--gray-400);display:inline-block;transition:background 0.3s;}
  .status-dot.connected{background:#4CAF50;box-shadow:0 0 6px #4CAF5088;}
  .status-label{font-size:12px;color:var(--blue-100);}
  .toolbar{background:var(--white);border-bottom:1px solid var(--gray-200);padding:12px 28px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
  .toolbar-group{display:flex;align-items:center;gap:8px;}
  .toolbar-label{font-size:12px;color:var(--gray-600);font-weight:500;white-space:nowrap;}
  .field{border:1px solid var(--gray-200);border-radius:var(--radius-sm);padding:7px 11px;font-size:13px;font-family:'Inter',sans-serif;color:var(--gray-800);background:var(--white);outline:none;transition:border-color 0.2s;}
  .field:focus{border-color:var(--blue-600);}
  .field-name{width:200px;}
  .btn{border:1px solid var(--gray-200);border-radius:var(--radius-sm);padding:7px 14px;font-size:13px;font-family:'Inter',sans-serif;font-weight:500;cursor:pointer;background:var(--white);color:var(--gray-800);display:inline-flex;align-items:center;gap:6px;transition:all 0.15s;white-space:nowrap;}
  .btn:hover{background:var(--gray-100);border-color:var(--gray-400);}
  .btn:active{transform:scale(0.98);}
  .btn-primary{background:var(--blue-800);color:var(--white);border-color:var(--blue-800);}
  .btn-primary:hover{background:var(--blue-900);}
  .btn-danger{background:var(--red-bg);color:var(--red);border-color:#FFCDD2;}
  .btn-pdf{background:var(--blue-50);color:var(--blue-800);border-color:var(--blue-100);}
  .btn:disabled{opacity:0.45;cursor:not-allowed;transform:none;}
  .view-toggle{display:flex;border:1px solid var(--gray-200);border-radius:var(--radius-sm);overflow:hidden;}
  .view-toggle .btn{border:none;border-radius:0;padding:7px 12px;font-size:12px;border-right:1px solid var(--gray-200);}
  .view-toggle .btn:last-child{border-right:none;}
  .view-toggle .btn.active{background:var(--blue-800);color:var(--white);}
  .unit-select{width:130px;}
  .toolbar-spacer{flex:1;}
  .main{padding:20px 28px;display:flex;flex-direction:column;gap:18px;}
  .connect-panel{background:var(--white);border:1px solid var(--blue-100);border-radius:var(--radius-lg);padding:20px 24px;display:flex;align-items:center;gap:16px;box-shadow:var(--shadow-sm);}
  .connect-icon{width:48px;height:48px;background:var(--blue-50);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
  .connect-info{flex:1;}
  .connect-info h3{font-size:14px;font-weight:600;color:var(--blue-900);}
  .connect-info p{font-size:12px;color:var(--gray-600);margin-top:2px;}
  .sensors-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;}
  .sensor-card{background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);transition:box-shadow 0.2s;}
  .sensor-card:hover{box-shadow:var(--shadow);}
  .sensor-card-header{padding:12px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--gray-200);}
  .sensor-card-title{font-size:13px;font-weight:600;color:var(--blue-900);}
  .sensor-card-pin{font-size:11px;font-family:'JetBrains Mono',monospace;background:var(--blue-50);color:var(--blue-800);padding:2px 8px;border-radius:20px;}
  .sensor-card-body{padding:16px;}
  .thermo-row{display:flex;align-items:center;gap:16px;margin-bottom:14px;}
  .thermo-visual{flex-shrink:0;width:24px;display:flex;flex-direction:column;align-items:center;gap:2px;}
  .thermo-tube{width:14px;height:72px;background:var(--gray-100);border-radius:7px;position:relative;overflow:hidden;border:1px solid var(--gray-200);}
  .thermo-fill{position:absolute;bottom:0;left:0;right:0;border-radius:0 0 7px 7px;transition:height 0.6s ease,background 0.6s ease;background:var(--blue-600);}
  .thermo-bulb{width:20px;height:20px;border-radius:50%;border:1px solid var(--gray-200);background:var(--blue-600);transition:background 0.6s ease;margin-top:-2px;}
  .temp-info{flex:1;}
  .temp-value{font-family:'JetBrains Mono',monospace;font-size:38px;font-weight:500;color:var(--blue-900);line-height:1;letter-spacing:-1px;}
  .temp-value .temp-unit{font-size:18px;color:var(--blue-600);letter-spacing:0;}
  .temp-label{font-size:11px;color:var(--gray-400);margin-top:4px;}
  .alert-badge{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:500;padding:3px 9px;border-radius:20px;margin-top:8px;}
  .alert-normal{background:var(--green-bg);color:var(--green);}
  .alert-high{background:var(--red-bg);color:var(--red);}
  .alert-low{background:var(--amber-bg);color:var(--amber);}
  .alert-error{background:var(--gray-100);color:var(--gray-600);}
  .sparkline-wrap{margin-top:12px;}
  .sparkline-label{font-size:10px;color:var(--gray-400);margin-bottom:4px;}
  .sparkline-bars{display:flex;gap:3px;align-items:flex-end;height:28px;}
  .sparkline-bar{flex:1;border-radius:2px 2px 0 0;min-height:3px;background:var(--blue-400);opacity:0.6;transition:height 0.4s;}
  .chart-panel{background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius-lg);padding:20px 24px;box-shadow:var(--shadow-sm);}
  .panel-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
  .panel-title{font-size:14px;font-weight:600;color:var(--blue-900);}
  .panel-sub{font-size:11px;color:var(--gray-400);margin-top:2px;}
  .chart-wrap{position:relative;width:100%;height:220px;}
  .history-panel{background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;}
  .history-panel .panel-header{padding:16px 20px 0;}
  .history-table-wrap{overflow-x:auto;}
  table{width:100%;border-collapse:collapse;font-size:13px;}
  thead th{background:var(--gray-50);color:var(--gray-600);font-weight:500;padding:10px 16px;text-align:left;border-bottom:1px solid var(--gray-200);white-space:nowrap;}
  tbody tr{border-bottom:1px solid var(--gray-100);transition:background 0.1s;}
  tbody tr:last-child{border-bottom:none;}
  tbody tr:hover{background:var(--gray-50);}
  tbody td{padding:9px 16px;color:var(--gray-800);font-family:'JetBrains Mono',monospace;font-size:12px;}
  tbody td.td-time{color:var(--gray-400);font-size:11px;}
  .no-data{padding:32px;text-align:center;color:var(--gray-400);font-size:13px;}
  .alert-banner{display:none;background:var(--red-bg);border:1px solid #FFCDD2;border-radius:var(--radius);padding:12px 18px;color:var(--red);font-size:13px;font-weight:500;align-items:center;gap:10px;}
  .alert-banner.visible{display:flex;}
  .overlay{position:fixed;inset:0;background:rgba(13,46,110,0.55);display:flex;align-items:center;justify-content:center;z-index:200;backdrop-filter:blur(4px);}
  .overlay.hidden{display:none;}
  .overlay-card{background:var(--white);border-radius:var(--radius-lg);padding:36px 40px;text-align:center;max-width:380px;box-shadow:var(--shadow-lg);}
  .overlay-icon{font-size:44px;margin-bottom:14px;}
  .overlay-title{font-size:18px;font-weight:600;color:var(--blue-900);margin-bottom:8px;}
  .overlay-text{font-size:13px;color:var(--gray-600);margin-bottom:22px;line-height:1.6;}
  .hidden{display:none!important;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .list-view{display:flex;flex-direction:column;gap:10px;}
  .list-item{background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius);padding:14px 20px;display:flex;align-items:center;gap:20px;box-shadow:var(--shadow-sm);}
  .list-sensor-name{font-weight:600;color:var(--blue-900);min-width:80px;font-size:13px;}
  .list-temp{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:500;color:var(--blue-900);min-width:90px;}
  .list-bar-wrap{flex:1;height:8px;background:var(--gray-100);border-radius:4px;overflow:hidden;}
  .list-bar{height:100%;border-radius:4px;background:var(--blue-600);transition:width 0.5s;}
</style>
</head>
<body>
<header class="topbar">
  <div class="topbar-left">
    <div class="topbar-logo">&#127777;</div>
    <div>
      <div class="topbar-title">Monitor de Temperatura Corporal</div>
      <div class="topbar-sub">ESP32 · DS18B20 · Web Serial API</div>
    </div>
  </div>
  <div class="topbar-right">
    <span class="status-dot" id="statusDot"></span>
    <span class="status-label" id="statusLabel">Desconectado</span>
  </div>
</header>
<div class="toolbar">
  <div class="toolbar-group">
    <span class="toolbar-label">Paciente:</span>
    <input class="field field-name" type="text" id="patientName" placeholder="Nombre del paciente">
  </div>
  <div class="toolbar-group">
    <span class="toolbar-label">Unidad:</span>
    <select class="field unit-select" id="unitSelect">
      <option value="C">Celsius (°C)</option>
      <option value="F">Fahrenheit (°F)</option>
      <option value="K">Kelvin (K)</option>
    </select>
  </div>
  <div class="toolbar-group">
    <span class="toolbar-label">Vista:</span>
    <div class="view-toggle">
      <button class="btn active" id="viewCards" onclick="setView('cards')">&#8862; Tarjetas</button>
      <button class="btn" id="viewList" onclick="setView('list')">&#9776; Lista</button>
      <button class="btn" id="viewChart" onclick="setView('chart')">&#128200; Gráfica</button>
    </div>
  </div>
  <div class="toolbar-spacer"></div>
  <button class="btn btn-pdf" id="pdfBtn" onclick="exportPDF()">&#11015; Descargar PDF</button>
</div>
<main class="main">
  <div class="alert-banner" id="alertBanner">&#9888;&#65039; <span id="alertText"></span></div>
  <div class="connect-panel" id="connectPanel">
    <div class="connect-icon">&#128268;</div>
    <div class="connect-info">
      <h3>Conectar ESP32</h3>
      <p>Selecciona el puerto COM donde está conectado el ESP32 y presiona Conectar.</p>
    </div>
    <button class="btn btn-primary" id="connectBtn" onclick="toggleConnect()">Conectar</button>
    <button class="btn btn-danger hidden" id="disconnectBtn" onclick="disconnect()">Desconectar</button>
  </div>
  <div id="cardsView"><div class="sensors-grid" id="sensorsGrid"></div></div>
  <div id="listView" class="hidden"><div class="list-view" id="listContainer"></div></div>
  <div class="chart-panel" id="chartPanel">
    <div class="panel-header">
      <div>
        <div class="panel-title">Temperatura en tiempo real</div>
        <div class="panel-sub" id="chartSub">Esperando datos...</div>
      </div>
    </div>
    <div class="chart-wrap"><canvas id="tempChart"></canvas></div>
  </div>
  <div class="history-panel" id="historyPanel">
    <div class="panel-header">
      <div><div class="panel-title">Historial de lecturas</div><div class="panel-sub">Últimas 50 muestras</div></div>
    </div>
    <div class="history-table-wrap">
      <div class="no-data" id="noDataMsg">Sin datos — conecta el ESP32 para comenzar.</div>
      <table id="historyTable" class="hidden">
        <thead><tr><th>Hora</th><th>Sensor 1 (Pin 4)</th><th>Sensor 2 (Pin 16)</th><th>Sensor 3 (Pin 27)</th><th>Sensor 4 (Pin 32)</th></tr></thead>
        <tbody id="historyBody"></tbody>
      </table>
    </div>
  </div>
</main>
<div class="overlay" id="overlay">
  <div class="overlay-card">
    <div class="overlay-icon">&#127777;</div>
    <div class="overlay-title">Monitor de Temperatura</div>
    <div class="overlay-text">Conecta el ESP32 al PC por USB y presiona el botón para comenzar a recibir datos de los 4 sensores DS18B20.<br><br><strong>Nota:</strong> Solo funciona en Chrome o Edge.</div>
    <button class="btn btn-primary" style="width:100%;justify-content:center;padding:10px;" onclick="toggleConnect()">&#128268; Conectar ESP32</button>
  </div>
</div>
<script>
const MAX_HISTORY=50,MAX_CHART_PTS=40,TEMP_HIGH=37.5,TEMP_LOW=34.0;
let port=null,reader=null,connected=false,buffer='';
const history=[],sparkHistory={1:[],2:[],3:[],4:[]};
const sensorMeta=[{id:1,pin:4},{id:2,pin:16},{id:3,pin:27},{id:4,pin:32}];
const CHART_COLORS=['#1565C0','#E53935','#2E7D32','#F57C00'];
let chart;

function initCards(){
  document.getElementById('sensorsGrid').innerHTML=sensorMeta.map(s=>`
  <div class="sensor-card" id="card${s.id}">
    <div class="sensor-card-header"><span class="sensor-card-title">Sensor ${s.id}</span><span class="sensor-card-pin">GPIO ${s.pin}</span></div>
    <div class="sensor-card-body">
      <div class="thermo-row">
        <div class="thermo-visual">
          <div class="thermo-tube"><div class="thermo-fill" id="fill${s.id}" style="height:30%;"></div></div>
          <div class="thermo-bulb" id="bulb${s.id}"></div>
        </div>
        <div class="temp-info">
          <div class="temp-value" id="val${s.id}">--<span class="temp-unit"> &deg;C</span></div>
          <div class="temp-label">Temperatura corporal</div>
          <span class="alert-badge alert-error" id="badge${s.id}">Sin señal</span>
        </div>
      </div>
      <div class="sparkline-wrap">
        <div class="sparkline-label">Últimas lecturas</div>
        <div class="sparkline-bars" id="spark${s.id}">${Array(10).fill('<div class="sparkline-bar" style="height:4px;opacity:0.2;"></div>').join('')}</div>
      </div>
    </div>
  </div>`).join('');
}

function initList(){
  document.getElementById('listContainer').innerHTML=sensorMeta.map(s=>`
  <div class="list-item">
    <div class="list-sensor-name">Sensor ${s.id}</div>
    <div class="list-temp" id="lval${s.id}">-- <small style="font-size:13px;color:#94A3B8;">&deg;C</small></div>
    <div class="list-bar-wrap"><div class="list-bar" id="lbar${s.id}" style="width:30%;"></div></div>
    <span class="alert-badge alert-error" id="lbadge${s.id}">Sin señal</span>
  </div>`).join('');
}

function initChart(){
  const ctx=document.getElementById('tempChart').getContext('2d');
  chart=new Chart(ctx,{type:'line',data:{labels:[],datasets:sensorMeta.map((s,i)=>({label:`Sensor ${s.id}`,data:[],borderColor:CHART_COLORS[i],backgroundColor:CHART_COLORS[i]+'18',borderWidth:2,pointRadius:0,tension:0.4,fill:false}))},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{display:true,position:'top',labels:{boxWidth:10,font:{size:12},padding:14,usePointStyle:true}},tooltip:{callbacks:{label:ctx=>` ${ctx.dataset.label}: ${formatTemp(ctx.raw)}`}}},scales:{x:{ticks:{font:{size:11},color:'#94A3B8',maxTicksLimit:8},grid:{color:'#F1F5F9'}},y:{ticks:{font:{size:11},color:'#94A3B8',callback:v=>formatTemp(v)},grid:{color:'#F1F5F9'},min:30,max:42}}}});
}

async function toggleConnect(){
  if(connected){disconnect();return;}
  if(!('serial' in navigator)){alert('Tu navegador no soporta Web Serial API.\nUsa Chrome o Edge (versión 89+).');return;}
  try{
    port=await navigator.serial.requestPort();
    await port.open({baudRate:115200});
    connected=true;
    setStatus(true);
    document.getElementById('overlay').classList.add('hidden');
    document.getElementById('connectBtn').classList.add('hidden');
    document.getElementById('disconnectBtn').classList.remove('hidden');
    startReading();
  }catch(e){if(e.name!=='NotSelectedError')alert('No se pudo abrir el puerto: '+e.message);}
}

async function disconnect(){
  connected=false;
  if(reader){try{await reader.cancel();}catch(_){}reader=null;}
  if(port){try{await port.close();}catch(_){}port=null;}
  setStatus(false);
  document.getElementById('connectBtn').classList.remove('hidden');
  document.getElementById('disconnectBtn').classList.add('hidden');
}

async function startReading(){
  const decoder=new TextDecoderStream();
  port.readable.pipeTo(decoder.writable);
  reader=decoder.readable.getReader();
  buffer='';
  try{
    while(connected){
      const{value,done}=await reader.read();
      if(done)break;
      buffer+=value;
      const lines=buffer.split('\n');
      buffer=lines.pop();
      for(const line of lines){const t=line.trim();if(t.startsWith('{'))parseLine(t);}
    }
  }catch(e){if(connected){console.warn('Serial error:',e);disconnect();}}
}

function parseLine(raw){
  try{
    const obj=JSON.parse(raw);
    if(!obj.s)return;
    const now=new Date();
    const timeStr=now.toLocaleTimeString('es-CO',{hour12:false});
    const entry={time:timeStr,sensors:obj.s};
    history.unshift(entry);
    if(history.length>MAX_HISTORY)history.pop();
    updateCards(obj.s);updateList(obj.s);updateChart(timeStr,obj.s);updateTable();checkAlerts(obj.s);
    document.getElementById('chartSub').textContent=`Última actualización: ${timeStr}`;
  }catch(e){}
}

function convertTemp(c){const u=document.getElementById('unitSelect').value;return u==='F'?c*9/5+32:u==='K'?c+273.15:c;}
function unitSymbol(){const u=document.getElementById('unitSelect').value;return u==='C'?'°C':u==='F'?'°F':'K';}
function formatTemp(t){if(t===null||t===undefined)return '--';return convertTemp(t).toFixed(1)+' '+unitSymbol();}
function getAlertInfo(t){
  if(t===null||!t)return{cls:'alert-error',label:'Sin señal',color:'#94A3B8'};
  if(t>TEMP_HIGH)return{cls:'alert-high',label:'Fiebre alta ⚠️',color:'#EF5350'};
  if(t<TEMP_LOW)return{cls:'alert-low',label:'Temp. baja ❄️',color:'#F57C00'};
  return{cls:'alert-normal',label:'Normal ✓',color:'#1976D2'};
}
function thermoHeight(t){if(!t)return 15;return Math.min(95,Math.max(10,((t-30)/12)*100));}

function updateCards(sensors){
  sensors.forEach(s=>{
    const info=getAlertInfo(s.t);const unit=unitSymbol();
    document.getElementById(`val${s.id}`).innerHTML=`${s.ok?convertTemp(s.t).toFixed(1):'--'}<span class="temp-unit"> ${unit}</span>`;
    const badge=document.getElementById(`badge${s.id}`);badge.className=`alert-badge ${info.cls}`;badge.textContent=info.label;
    document.getElementById(`fill${s.id}`).style.height=thermoHeight(s.t)+'%';
    document.getElementById(`fill${s.id}`).style.background=info.color;
    document.getElementById(`bulb${s.id}`).style.background=info.color;
    if(s.ok&&s.t){sparkHistory[s.id].push(s.t);if(sparkHistory[s.id].length>10)sparkHistory[s.id].shift();}
    const bars=document.getElementById(`spark${s.id}`);const vals=sparkHistory[s.id];
    if(vals.length>1){const mn=Math.min(...vals),mx=Math.max(...vals);bars.innerHTML=vals.map(v=>`<div class="sparkline-bar" style="height:${Math.max(4,Math.round(((v-mn+0.3)/(mx-mn+1))*24))}px;background:${info.color};"></div>`).join('');}
  });
}

function updateList(sensors){
  sensors.forEach(s=>{
    const info=getAlertInfo(s.t);const unit=unitSymbol();
    document.getElementById(`lval${s.id}`).innerHTML=`${s.ok&&s.t?convertTemp(s.t).toFixed(1):'--'} <small style="font-size:13px;color:#94A3B8;">${unit}</small>`;
    const badge=document.getElementById(`lbadge${s.id}`);badge.className=`alert-badge ${info.cls}`;badge.textContent=info.label;
    const pct=s.ok&&s.t?thermoHeight(s.t):15;
    document.getElementById(`lbar${s.id}`).style.width=pct+'%';
    document.getElementById(`lbar${s.id}`).style.background=info.color;
  });
}

function updateChart(timeStr,sensors){
  chart.data.labels.push(timeStr);
  if(chart.data.labels.length>MAX_CHART_PTS)chart.data.labels.shift();
  sensors.forEach((s,i)=>{
    const val=s.ok&&s.t?parseFloat(convertTemp(s.t).toFixed(2)):null;
    chart.data.datasets[i].data.push(val);
    if(chart.data.datasets[i].data.length>MAX_CHART_PTS)chart.data.datasets[i].data.shift();
  });
  chart.update('none');
}

function updateTable(){
  if(history.length===0)return;
  document.getElementById('noDataMsg').classList.add('hidden');
  document.getElementById('historyTable').classList.remove('hidden');
  document.getElementById('historyBody').innerHTML=history.map(entry=>{
    const cols=sensorMeta.map(m=>{const s=entry.sensors.find(x=>x.id===m.id);if(!s||!s.ok)return'<td class="mono">--</td>';const info=getAlertInfo(s.t);return`<td class="mono" style="color:${info.color}">${formatTemp(s.t)}</td>`;}).join('');
    return`<tr><td class="td-time mono">${entry.time}</td>${cols}</tr>`;
  }).join('');
}

function checkAlerts(sensors){
  const issues=sensors.filter(s=>s.ok&&s.t&&(s.t>TEMP_HIGH||s.t<TEMP_LOW));
  const banner=document.getElementById('alertBanner');
  if(issues.length>0){document.getElementById('alertText').textContent=issues.map(s=>`Sensor ${s.id}: ${formatTemp(s.t)}`).join(' | ');banner.classList.add('visible');}
  else banner.classList.remove('visible');
}

function setView(view){
  document.getElementById('cardsView').classList.toggle('hidden',view!=='cards');
  document.getElementById('listView').classList.toggle('hidden',view!=='list');
  document.getElementById('chartPanel').classList.toggle('hidden',view!=='chart');
  document.getElementById('historyPanel').classList.toggle('hidden',view==='chart');
  ['viewCards','viewList','viewChart'].forEach(id=>document.getElementById(id).classList.remove('active'));
  document.getElementById('view'+view.charAt(0).toUpperCase()+view.slice(1)).classList.add('active');
}

function setStatus(on){
  document.getElementById('statusDot').className='status-dot '+(on?'connected':'');
  document.getElementById('statusLabel').textContent=on?'Conectado':'Desconectado';
}

function exportPDF(){
  const{jsPDF}=window.jspdf;
  const doc=new jsPDF();
  const patient=document.getElementById('patientName').value||'Sin nombre';
  const now=new Date().toLocaleString('es-CO');
  doc.setFillColor(13,46,110);doc.rect(0,0,210,28,'F');
  doc.setTextColor(255,255,255);doc.setFontSize(14);doc.setFont('helvetica','bold');
  doc.text('Monitor de Temperatura Corporal',14,12);
  doc.setFontSize(9);doc.setFont('helvetica','normal');doc.text('ESP32 · DS18B20 · Informe de sesión',14,20);
  doc.setTextColor(30,41,59);doc.setFontSize(11);doc.setFont('helvetica','bold');doc.text('Paciente:',14,38);
  doc.setFont('helvetica','normal');doc.text(patient,40,38);
  doc.setFont('helvetica','bold');doc.text('Fecha:',120,38);
  doc.setFont('helvetica','normal');doc.text(now,138,38);
  doc.setDrawColor(200,214,229);doc.line(14,43,196,43);
  doc.setFontSize(11);doc.setFont('helvetica','bold');doc.setTextColor(13,46,110);doc.text('Última lectura',14,52);
  let y=60;
  if(history.length>0){
    history[0].sensors.forEach(s=>{
      const info=getAlertInfo(s.t);
      doc.setFont('helvetica','normal');doc.setFontSize(10);doc.setTextColor(30,41,59);
      doc.text(`Sensor ${s.id} (GPIO ${s.pin}):`,20,y);
      doc.setFont('helvetica','bold');doc.text(s.ok&&s.t?formatTemp(s.t):'-- (sin señal)',80,y);
      doc.setFontSize(9);doc.setFont('helvetica','italic');doc.setTextColor(100,116,139);
      doc.text(info.label.replace(/[⚠️❄️✓]/g,'').trim(),130,y);y+=9;
    });
    doc.setFontSize(11);doc.setFont('helvetica','bold');doc.setTextColor(13,46,110);doc.text('Historial',14,y+8);y+=16;
    const cols=[22,40,40,40,40];
    doc.setFillColor(227,242,253);doc.rect(14,y-5,182,8,'F');
    doc.setFont('helvetica','bold');doc.setFontSize(9);doc.setTextColor(21,101,192);
    let tx=16;['Hora','Sensor 1','Sensor 2','Sensor 3','Sensor 4'].forEach((h,i)=>{doc.text(h,tx,y);tx+=cols[i];});y+=6;
    history.slice(0,30).forEach((entry,ri)=>{
      if(ri%2===0){doc.setFillColor(248,250,252);doc.rect(14,y-5,182,7,'F');}
      doc.setFont('helvetica','normal');doc.setFontSize(8);doc.setTextColor(30,41,59);
      const row=[entry.time,...sensorMeta.map(m=>{const s=entry.sensors.find(x=>x.id===m.id);return(s&&s.ok&&s.t)?formatTemp(s.t):'--';})]
      let tx2=16;row.forEach((cell,i)=>{doc.text(cell,tx2,y);tx2+=cols[i];});y+=7;
      if(y>270){doc.addPage();y=20;}
    });
  }else{doc.setFont('helvetica','italic');doc.setFontSize(10);doc.setTextColor(100,116,139);doc.text('Sin datos registrados.',20,60);}
  doc.save(`temperatura_${patient.replace(/ /g,'_')}_${Date.now()}.pdf`);
}

document.getElementById('unitSelect').addEventListener('change',()=>{if(history.length>0)updateCards(history[0].sensors);updateTable();});
initCards();initList();initChart();setView('cards');
</script>
